# Aplicación
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bita_db
DB_SYNC=true

# Autenticación (mínimo 64 caracteres)
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-64-caracteres-generado-aleatoriamente
