# --- Aplicacion ---
PORT=3000
NODE_ENV=development
# Opcional: origenes permitidos por CORS, separados por coma.
# CORS_ORIGINS=http://localhost:3001

# --- Base de datos ---
# Opcion A (local, docker compose): variables individuales
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bita_db

# Opcion B (Neon / produccion): cadena de conexion unica.
# Si DATABASE_URL esta definida, tiene prioridad sobre DB_HOST/DB_PORT/etc.
# DATABASE_URL=postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/bita_db?sslmode=require

# SSL (se activa solo en produccion o cuando DATABASE_URL esta definida)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# TypeORM sincroniza el esquema. Usar false cuando haya migraciones.
DB_SYNC=true

# --- Autenticacion (minimo 64 caracteres) ---
JWT_SECRET=a0e01ef9a4bc390a137c89945c14bbbacd4030ce1d29cecb1645d89c4f7e9f0e
